# --- Database -----------------------------------------------------------------
# Default: a local SQLite file at ./data/validly.db (nothing to set).
# Production: a hosted libSQL database (e.g. Turso), because serverless hosts
# don't keep local files between requests.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-token

# --- Public URL ---------------------------------------------------------------
# Used for absolute links in link previews. Auto-detected from the request if unset.
# APP_URL=https://validly.example

# --- Moderation ---------------------------------------------------------------
# Comma-separated emails (of saved accounts) that can open /admin to restore or
# delete pages that visitors reported.
# ADMIN_EMAILS=you@example.com
